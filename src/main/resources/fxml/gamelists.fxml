<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.gamevault.controller.GameListController"
        styleClass="root-pane">

    <!-- ════════════════════════════════════════════════════════════════════
         SIDEBAR  (identique main.fxml)
         ════════════════════════════════════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" minWidth="220">

            <!-- Logo placeholder -->
            <HBox alignment="CENTER_LEFT">
                <padding><Insets top="20" right="16" bottom="16" left="16"/></padding>
                <ImageView fx:id="logoImage" fitWidth="185" fitHeight="60"
                           preserveRatio="true" smooth="true"/>
            </HBox>

            <!-- Navigation -->
            <VBox spacing="4">
                <padding><Insets top="6" right="12" bottom="6" left="12"/></padding>
                <Button fx:id="btnAccueil"    onAction="#onAccueil"
                        text="&#x2302;   Accueil"
                        styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnAjouter"    onAction="#onAjouter"
                        text="+   Ajouter un jeu"
                        styleClass="nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnCollection" onAction="#onCollection"
                        text="&#x2630;   Collection"
                        styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
                <Button fx:id="btnAPropos"    onAction="#onAPropos"
                        text="&#x24D8;   &#xC0; Propos"
                        styleClass="nav-btn" maxWidth="Infinity"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Utilisateur -->
            <VBox alignment="CENTER" spacing="10">
                <padding><Insets top="16" right="16" bottom="28" left="16"/></padding>
                <StackPane styleClass="sidebar-avatar" prefWidth="90" prefHeight="90">
                    <ImageView fx:id="avatarImage" fitWidth="60" fitHeight="60"
                               preserveRatio="true" smooth="true"/>
                </StackPane>
                <Label fx:id="usernameLabel" text="Nom d'utilisateur" styleClass="username-label"/>
            </VBox>
        </VBox>
    </left>

    <!-- ════════════════════════════════════════════════════════════════════
         ZONE DROITE
         ════════════════════════════════════════════════════════════════════ -->
    <center>
        <BorderPane>

            <!-- Topbar -->
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                    <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
                    <TextField fx:id="searchField" promptText="Recherche"
                               styleClass="search-field" prefWidth="300"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="topbar-avatar" prefWidth="58" prefHeight="58">
                        <ImageView fx:id="avatarTopBar" fitWidth="42" fitHeight="42"
                                   preserveRatio="true" smooth="true"/>
                    </StackPane>
                </HBox>
            </top>

            <!-- Tableau -->
            <center>
                <VBox spacing="0" style="-fx-padding: 20 24 24 24; -fx-background-color: #0a1628;">
                    <TableView fx:id="gameTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCover"    text=""           prefWidth="70"  minWidth="70" maxWidth="70" resizable="false"/>
                            <TableColumn fx:id="colTitle"    text="Titre"      prefWidth="230"/>
                            <TableColumn fx:id="colPlatform" text="Plateforme" prefWidth="200"/>
                            <TableColumn fx:id="colYear"     text="Année"      prefWidth="90"/>
                            <TableColumn fx:id="colRating"   text="Note"       prefWidth="70"/>
                            <TableColumn fx:id="colFavorite" text="Favori"     prefWidth="70" minWidth="70" maxWidth="70" resizable="false"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucun jeu dans la collection."
                                   style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 14;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>
